<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published package advisory, or an unreachable advisory feed, shouldn't break
         every build; both still show. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <Version>0.0.0-dev</Version>
    <Authors>Renderapp</Authors>
    <Copyright>Copyright (c) Renderapp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/renderappio/renderapp-uploader</RepositoryUrl>
  </PropertyGroup>

</Project>
